# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Unity-specific paths are relative to /GameProject/ in this repository.
/GameProject/.utmp/
/GameProject/[Ll]ibrary/
/GameProject/[Tt]emp/
/GameProject/[Oo]bj/
/GameProject/[Bb]uild/
/GameProject/[Bb]uilds/
/GameProject/[Ll]ogs/
/GameProject/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/GameProject/[Mm]emoryCaptures/

# Recordings can get excessive in size
/GameProject/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/GameProject/[Aa]ssets/Plugins/Editor/JetBrains*

# JetBrains Rider personal settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/GameProject/ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.ipa
*.unitypackage
*.unitypackage.meta
*.app

# IL2CPP and Burst build debug output
/GameProject/*_BackUpThisFolder_ButDontShipItWithYourGame/
/GameProject/*_BurstDebugInformation_DoNotShip/

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/GameProject/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
# Keep release content state for Addressables content updates
!/GameProject/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/addressables_content_state.bin
!/GameProject/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/addressables_content_state.bin.meta
/GameProject/ServerData/
/GameProject/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml
/GameProject/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml.meta
/GameProject/[Aa]ssets/Addressables_Temp/
/GameProject/[Aa]ssets/Addressables_Temp.meta

# Temporary auto-generated Android Assets
/GameProject/[Aa]ssets/[Ss]treamingAssets/aa.meta
/GameProject/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity-generated test scenes and editor caches
/GameProject/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity
/GameProject/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity.meta
/GameProject/UIElementsSchema/
/GameProject/[Aa]ssets/[Ss]ceneDependencyCache*

# Visual Scripting generated files
/GameProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/GameProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/GameProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
/GameProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Blender backup files
*.blend1
*.blend1.meta

# Android and Apple signing files (store securely outside Git)
*.keystore
*.keystore.meta
*.jks
*.jks.meta
*.p12
*.p12.meta
*.pfx
*.pfx.meta
*.mobileprovision
*.mobileprovision.meta
*.provisionprofile
*.provisionprofile.meta

# Windows and macOS generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
._*

# Locally extracted Steamworks SDKs
/steamworks_sdk_*/
